---
import Base from '../layouts/Base.astro';
import RecipeTable from '../components/RecipeTable.astro';
import { getPostsChronological } from '../lib/posts';
import { renderMarkdown } from '../lib/markdown';

export async function getStaticPaths() {
  const posts = await getPostsChronological();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, entryNo: index + 1 },
  }));
}

const { post, entryNo } = Astro.props;
const images = post.data.images;
const type = post.data.type === 'drink' ? 'Drink' : 'Food';
const logged = post.data.date.toISOString().slice(0, 10);

// Split the body at the first section heading so the recipe table can sit
// between the introductory text and the Ingredients/Method sections
const body = post.body ?? '';
const splitAt = body.search(/^## /m);
const introHtml = await renderMarkdown(splitAt === -1 ? body : body.slice(0, splitAt));
const sectionsHtml = splitAt === -1 ? '' : await renderMarkdown(body.slice(splitAt));
---

<Base title={post.data.title} description={post.data.description} images={images} isPost>
  <div class="o-container">
    <header class="o-spec">
      <p class="o-spec__no">Entry #{String(entryNo).padStart(2, '0')} · {type}</p>
      <h1 class="o-spec__title">{post.data.title}</h1>
      <div class="o-spec__facts">
        <div class="o-fact">
          <span>Logged</span>
          {logged}
        </div>
        {
          images && (
            <div class="o-fact">
              <span>Photos</span>
              {images.length}
            </div>
          )
        }
      </div>
    </header>

    <div class="o-markdown" set:html={introHtml} />

    {
      post.data.table && (
        <>
          <h2 class="o-section-label">Visual</h2>
          <RecipeTable table={post.data.table} />
        </>
      )
    }

    {sectionsHtml && <div class="o-markdown" set:html={sectionsHtml} />}

    <div class="o-back">
      <a href="/">← Back to the log</a>
    </div>

    {
      images && (
        <div class="o-images">
          {images.map((image) => (
            <a href={image.path}>
              <img src={image.path} alt={image.alt} />
            </a>
          ))}
        </div>
      )
    }
  </div>
</Base>
