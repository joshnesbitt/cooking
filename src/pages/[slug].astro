---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPostsChronological } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPostsChronological();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, entryNo: index + 1 },
  }));
}

const { post, entryNo } = Astro.props;
const { Content } = await render(post);
const images = post.data.images;
const type = post.data.type === 'drink' ? 'Drink' : 'Food';
const logged = post.data.date.toISOString().slice(0, 10);
---

<Base title={post.data.title} description={post.data.description} images={images} isPost>
  <div class="o-container">
    <header class="o-spec">
      <p class="o-spec__no">Entry № {String(entryNo).padStart(2, '0')} · {type}</p>
      <h1 class="o-spec__title">{post.data.title}</h1>
      <div class="o-spec__facts">
        <div class="o-fact">
          <span>Logged</span>
          {logged}
        </div>
        {
          images && (
            <div class="o-fact">
              <span>Photos</span>
              {images.length}
            </div>
          )
        }
      </div>
    </header>

    <div class="o-markdown">
      <Content />
    </div>

    <div class="u-margin-top">
      <p>
        <a href="/">← Back to the log</a>
      </p>
    </div>

    {
      images && (
        <div class="o-images">
          {images.map((image) => (
            <a href={image.path}>
              <img src={image.path} alt={image.alt} />
            </a>
          ))}
        </div>
      )
    }
  </div>
</Base>
