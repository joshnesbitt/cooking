---
import Base from '../layouts/Base.astro';
import { getPostsChronological } from '../lib/posts';

const chronological = await getPostsChronological();
const entries = chronological
  .map((post, index) => ({ post, no: index + 1 }))
  .reverse();

const firstYear = chronological[0].data.date.getUTCFullYear();

const formatDate = (date: Date) =>
  `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
---

<Base>
  <div class="o-container">
    <header class="o-masthead">
      <h1 class="o-masthead__title">Cooking Notebook</h1>
      <p class="o-masthead__sub">
        Findings from the kitchen, {firstYear} → present. {chronological.length} entries.
      </p>
    </header>

    <table class="o-log">
      <thead>
        <tr>
          <th>No.</th>
          <th>Entry</th>
          <th>Type</th>
          <th class="o-log__date">Logged</th>
        </tr>
      </thead>
      <tbody>
        {
          entries.map(({ post, no }) => (
            <tr>
              <td class="o-log__no">{String(no).padStart(2, '0')}</td>
              <td class="o-log__title">
                <a href={`/${post.id}/`}>{post.data.title}</a>
              </td>
              <td class="o-log__type">
                <span class:list={['o-chip', { 'o-chip--food': post.data.type !== 'drink' }]}>
                  {post.data.type === 'drink' ? 'drink' : 'food'}
                </span>
              </td>
              <td class="o-log__date">{formatDate(post.data.date)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Base>
