---
import Base from '../layouts/Base.astro';
import { glossary, mentionsTerm } from '../lib/glossary';
import { getPostsChronological } from '../lib/posts';

const posts = await getPostsChronological();
const entryNo = new Map(posts.map((post, index) => [post.id, index + 1]));
const label = (post: (typeof posts)[number]) =>
  `${String(entryNo.get(post.id)).padStart(2, '0')} ${post.data.title}`;

const terms = [...glossary]
  .sort((a, b) => a.term.localeCompare(b.term))
  .map((term) => ({
    term,
    entry: term.entry ? posts.find((post) => post.id === term.entry) : undefined,
    usedIn: posts.filter(
      (post) => post.id !== term.entry && mentionsTerm(term, post.body ?? '')
    ),
  }));

// Drift detection: a term no entry mentions any more has rotted out of the
// log and should be pruned (or its aliases fixed)
for (const { term, entry, usedIn } of terms) {
  if (!entry && usedIn.length === 0) {
    console.warn(`[appendix] "${term.term}" is not mentioned by any entry`);
  }
}
---

<Base
  title="Appendix"
  description="Definitions of technical terms used in the log."
  slug="appendix"
>
  <div class="o-container">
    <header class="o-masthead">
      <h1 class="o-masthead__title">Appendix</h1>
      <p class="o-masthead__sub">
        Definitions of technical terms used in the log.
      </p>
    </header>

    <dl class="o-appendix">
      {
        terms.map(({ term, entry, usedIn }) => (
          <div class="o-appendix__item" id={term.id}>
            <dt class="o-appendix__term">{term.term}</dt>
            <dd class="o-appendix__body">
              <p>{term.definition}</p>
              {(entry || usedIn.length > 0) && (
                <p class="o-appendix__uses">
                  {entry && (
                    <span>
                      Entry: <a href={`/${entry.id}/`}>{label(entry)}</a>
                    </span>
                  )}
                  {entry && usedIn.length > 0 && ' · '}
                  {usedIn.length > 0 && (
                    <span>
                      Used in:{' '}
                      {usedIn.map((post, index) => (
                        <>{index > 0 && ', '}<a href={`/${post.id}/`}>{label(post)}</a></>
                      ))}
                    </span>
                  )}
                </p>
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="o-back">
      <a href="/">← Back to the log</a>
    </div>
  </div>
</Base>
